{
  "name": "web-agenda-icci",
  "version": "0.1.0",
  "private": true,
  "description": "Agenda académica de ICCI UCSH para mentorías, apoyo PACE y ayudantías con calendario semanal y hitos del semestre.",
  "keywords": [
    "academica",
    "agenda",
    "calendar",
    "educacion",
    "icci",
    "mentorias",
    "pace",
    "react",
    "tutoria",
    "ucsh",
    "universidad",
    "vite"
  ],
  "homepage": "https://github.com/open-ucsh/web-agenda-icci",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-ucsh/web-agenda-icci.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run data:export && vp dev",
    "build": "vp run data:export && tsc --noEmit && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "check": "vp run data:export && vp check",
    "test": "vp run data:export && vp test",
    "data:export": "python3 scripts/export-agenda.py"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
